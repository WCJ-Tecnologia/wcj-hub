APP_NAME="WCJ Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

# Brand shown in the shell. The logo is a path under public/.
APP_BRAND_NAME="WCJ Hub"
APP_BRAND_LOGO=/brand/logo.svg
APP_THEME_COLOR=#111827

# Proxy/load balancer IPs (comma separated) or "*" behind one you control.
# Empty = no proxy trusted; X-Forwarded-* headers are ignored.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 in production (see docker-compose.yml). For a quick local start:
# DB_CONNECTION=sqlite and DB_DATABASE=database/database.sqlite (touch it first).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production. Keep false only on plain HTTP in dev.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Attempts per minute on login / forgot / reset / first access.
AUTH_THROTTLE_PER_ACCOUNT=5
AUTH_THROTTLE_PER_IP=20

# Origins allowed to call /api/health cross-origin (comma separated). Empty = none.
CORS_ALLOWED_ORIGINS=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
