# WCJ Hub. Every variable the app reads, with fake or local values.
# Everything external starts OFF (stacks/laravel-inertia.md §8): e-mail goes to the
# log, no SMTP, no OAuth client, no external storage. Turning one on is a manual step.
# Production values live on the server, never here (docs/DEPLOY.md).

APP_NAME="WCJ Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
# The database stores UTC (fixed in config/app.php); people read this zone.
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

# Brand shown in the shell. The logo is a path under public/.
APP_BRAND_NAME="WCJ Hub"
APP_THEME_COLOR=#0C0E13

# Proxy/load balancer IPs (comma separated) or "*" behind one you control.
# Empty = no proxy trusted; X-Forwarded-* headers are ignored.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8, also in tests (ADR-002): `docker compose up -d mysql` starts it with these
# values and creates wcj_hub_test and wcj_hub_e2e next to it (init SQL in docker-compose.yml).
# They are local-only values, not a secret. Never point a dev .env at production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wcj_hub
DB_USERNAME=wcj_hub
DB_PASSWORD=wcj_hub_local
DB_COLLATION=utf8mb4_0900_ai_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production. Keep false only on plain HTTP in dev.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
# Task attachments (P24, P36) stay on the local disk, outside public/.
FILESYSTEM_DISK=local
# Notifications by e-mail (P22, R3) go through the queue: run `php artisan queue:work`
# (composer dev starts one).
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Attempts per minute on login / forgot / reset / first access.
AUTH_THROTTLE_PER_ACCOUNT=5
AUTH_THROTTLE_PER_IP=20

# Origins allowed to call /api/health cross-origin (comma separated). Empty = none.
CORS_ALLOWED_ORIGINS=

# E-mail: OFF. "log" writes the message to storage/logs instead of sending it.
# Production uses the WCJ Zoho SMTP (escopo §7: credentials kept by Lucas Scholz, never
# in the repo). To test real sending, switch to smtp and fill in by hand:
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.zoho.com  MAIL_PORT=465  MAIL_ENCRYPTION=ssl
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Passport (OAuth for the users' AI, B8). Keys are files in storage/ (oauth-*.key,
# git-ignored), created by `composer setup`. On a server without those files, paste
# them into these two variables instead (multi-line, quoted). The /oauth/* routes stay
# off until B8.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# AI connections (docs/banco.md T5; config/hub.php). Limits per AI authorization.
HUB_AI_READS_PER_MINUTE=60
HUB_AI_WRITES_PER_MINUTE=20
HUB_AI_LOG_RETENTION_DAYS=180

VITE_APP_NAME="${APP_NAME}"
