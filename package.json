{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "wcj-hub",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "theme": "node scripts/build-theme.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write resources/js e2e .storybook playwright.config.ts eslint.config.js",
        "format:check": "prettier --check resources/js e2e .storybook playwright.config.ts eslint.config.js",
        "e2e:prepare": "node e2e/prepare.mjs",
        "e2e:serve": "APP_ENV=e2e php artisan serve --host=127.0.0.1 --port=8000",
        "test:e2e": "playwright test",
        "test:e2e:smoke": "playwright test --grep @smoke",
        "shadcn": "node scripts/shadcn.mjs",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test:guard": "node --test .ai/adapters/guard/*.test.mjs",
        "test:skills": "node --test .ai/skills/*.test.mjs",
        "skills:install": "node .ai/skills/instalar.mjs",
        "specs:check": "node .ai/skills/conferir-specs.mjs"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@storybook/addon-a11y": "^10.6.1",
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/addon-themes": "^10.6.1",
        "@storybook/react-vite": "^10.6.1",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.10.2",
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",
        "@vitejs/plugin-react": "^4.4.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": "^10.6.1",
        "globals": "^17.12.0",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.9.8",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "storybook": "^10.6.1",
        "tailwindcss": "^4.1.11",
        "tw-animate-css": "^1.2.5",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.70.1",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@inertiajs/react": "^2.0.0",
        "@radix-ui/react-avatar": "^1.1.2",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.4",
        "@radix-ui/react-label": "^2.1.1",
        "@radix-ui/react-separator": "^1.1.1",
        "@radix-ui/react-slot": "^1.1.1",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tooltip": "^1.1.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.0.0",
        "lucide-react": "^0.469.0",
        "radix-ui": "^1.7.0",
        "react": "^19.0.0",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.0.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^2.6.0"
    }
}
