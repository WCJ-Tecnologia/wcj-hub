# Environment for the Playwright suite. `npm run e2e:prepare` copies this to
# .env.e2e (git-ignored), generates APP_KEY and rebuilds database/e2e.sqlite.
# Nothing here is a real secret: the admin below exists only in that database.
APP_NAME=ai-systems
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=pt_BR
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_BRAND_NAME=ai-systems
APP_BRAND_LOGO=/brand/logo.svg

BCRYPT_ROUNDS=4
LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Per-account limit stays at the real value (the suite proves the 429).
# The per-IP ceiling is loosened so the rest of the suite is not blocked.
AUTH_THROTTLE_PER_ACCOUNT=5
AUTH_THROTTLE_PER_IP=200

# Credentials for the e2e admin. Test-only; refused in production.
# The password stays empty here: `npm run e2e:prepare` generates a random one
# into .env.e2e (git-ignored). No admin password lives in a versioned file.
E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=

# Playwright
E2E_BASE_URL=http://127.0.0.1:8000
