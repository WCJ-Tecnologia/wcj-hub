# Loaded by PHPUnit (APP_ENV=testing). Versioned on purpose: nothing here is a
# secret. APP_KEY is base64("testing-only-key-do-not-use-prod") and exists only
# so cookies can be encrypted inside the test process.
# The database is MySQL 8, never SQLite (ADR-002, D-GER-22): the local one from
# docker-compose.yml (database wcj_hub_test, created by the init SQL in docker-compose.yml) or
# the CI service. DB_USERNAME/DB_PASSWORD are the local docker values from
# .env.example; an exported variable wins over this file.
APP_NAME="WCJ Hub"
APP_ENV=testing
APP_KEY=base64:dGVzdGluZy1vbmx5LWtleS1kby1ub3QtdXNlLXByb2Q=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_BRAND_NAME="WCJ Hub"
APP_BRAND_LOGO=/brand/logo.svg

BCRYPT_ROUNDS=4
LOG_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wcj_hub_test
DB_USERNAME=wcj_hub
DB_PASSWORD=wcj_hub_local

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
