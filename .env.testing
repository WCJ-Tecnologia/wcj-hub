# Loaded by PHPUnit (APP_ENV=testing). Versioned on purpose: nothing here is a
# secret. APP_KEY is base64("testing-only-key-do-not-use-prod") and exists only
# so cookies can be encrypted inside the test process.
APP_NAME=ai-systems
APP_ENV=testing
APP_KEY=base64:dGVzdGluZy1vbmx5LWtleS1kby1ub3QtdXNlLXByb2Q=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_BRAND_NAME=ai-systems
APP_BRAND_LOGO=/brand/logo.svg

BCRYPT_ROUNDS=4
LOG_CHANNEL=null

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
